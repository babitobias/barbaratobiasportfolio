<script>
// ─── EmailJS ────────────────────────────────────────────────
// INSTRUÇÕES: Crie conta grátis em https://www.emailjs.com
// Depois substitua os 3 valores abaixo pelos seus:
const EMAILJS_PUBLIC_KEY  = 'SUA_PUBLIC_KEY';   // Account > API Keys
const EMAILJS_SERVICE_ID  = 'SUA_SERVICE_ID';   // Email Services
const EMAILJS_TEMPLATE_ID = 'SUA_TEMPLATE_ID';  // Email Templates

emailjs.init(EMAILJS_PUBLIC_KEY);

async function handleForm(e) {
  e.preventDefault();

  const btn    = document.getElementById('submitBtn');
  const status = document.getElementById('form-status');

  btn.disabled    = true;
  btn.textContent = 'Enviando... ⏳';
  status.style.display = 'none';

  const templateParams = {
    from_name:  document.getElementById('from_name').value,
    from_email: document.getElementById('from_email').value,
    message:    document.getElementById('message').value,
    to_email:   'barbarayasmimpimenta@gmail.com'
  };

  try {
    await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams);
    status.textContent     = '💜 Mensagem enviada! Logo entrarei em contato.';
    status.style.color     = '#c49be0';
    status.style.display   = 'block';
    e.target.reset();
  } catch (err) {
    status.textContent   = '❌ Erro ao enviar. Tente pelo e-mail direto!';
    status.style.color   = '#ff6b6b';
    status.style.display = 'block';
    console.error(err);
  } finally {
    btn.disabled    = false;
    btn.textContent = 'Enviar mensagem 💌';
  }
}

(function() {
  const canvas = document.getElementById('glitter-canvas');
  const ctx = canvas.getContext('2d');

  const COLORS = [
    [196,155,224], // purple-light
    [191,109,184], // pink
    [168,68,158],  // pinkdark
    [94,207,196],  // teal
    [255,255,255], // white
    [220,180,255], // lavender
    [255,200,240], // blush
    [150,100,220], // violet
  ];

  let particles = [];
  let W, H;
  const SCROLL_H = () => Math.max(document.body.scrollHeight, document.documentElement.scrollHeight, window.innerHeight);

  function rand(a, b) { return Math.random() * (b - a) + a; }
  function randInt(a, b) { return Math.floor(rand(a, b)); }

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = SCROLL_H();
    if (particles.length === 0) spawnBurst();
  }

  // shapes: 0=diamond, 1=star4, 2=circle, 3=rect
  function createParticle(atTop) {
    const c = COLORS[randInt(0, COLORS.length)];
    const size = rand(3, 11);
    return {
      x: rand(-20, W + 20),
      y: atTop ? rand(-200, 0) : rand(0, H),
      size,
      speedY: rand(1.8, 5.5),
      speedX: rand(-1.2, 1.2),
      rot: rand(0, Math.PI * 2),
      rotSpeed: rand(-0.12, 0.12),
      opacity: rand(0.55, 1.0),
      twinkle: rand(0, Math.PI * 2),
      twinkleSpeed: rand(0.06, 0.18),
      color: c,
      shape: randInt(0, 4),
      swing: rand(0, Math.PI * 2),
      swingSpeed: rand(0.02, 0.06),
      swingAmp: rand(0.4, 1.8),
    };
  }

  function spawnBurst() {
    const count = Math.floor(W / 3.5);
    for (let i = 0; i < count; i++) particles.push(createParticle(false));
  }

  function drawStar4(ctx, r) {
    for (let a = 0; a < 4; a++) {
      ctx.beginPath();
      ctx.ellipse(0, 0, r * 0.22, r, (Math.PI / 4) * a * 2, false);
      ctx.fill();
    }
  }

  function drawDiamond(ctx, r) {
    ctx.beginPath();
    ctx.moveTo(0, -r);
    ctx.lineTo(r * 0.55, 0);
    ctx.lineTo(0, r);
    ctx.lineTo(-r * 0.55, 0);
    ctx.closePath();
    ctx.fill();
  }

  function draw(ts) {
    ctx.clearRect(0, 0, W, H);

    // spawn new particles continuously from top
    if (Math.random() < 0.55) {
      const batch = randInt(2, 6);
      for (let b = 0; b < batch; b++) {
        const p = createParticle(true);
        p.y = rand(-30, -5);
        particles.push(p);
      }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      const twinkle = 0.5 + 0.5 * Math.sin(p.twinkle);
      const alpha = p.opacity * twinkle;
      const [r, g, b] = p.color;

      ctx.save();
      p.swing += p.swingSpeed;
      p.x += Math.sin(p.swing) * p.swingAmp + p.speedX * 0.3;
      p.y += p.speedY;
      p.rot += p.rotSpeed;
      p.twinkle += p.twinkleSpeed;

      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
      ctx.shadowColor = `rgba(${r},${g},${b},0.8)`;
      ctx.shadowBlur = p.size * 2.5;

      if (p.shape === 0) drawDiamond(ctx, p.size);
      else if (p.shape === 1) drawStar4(ctx, p.size);
      else if (p.shape === 2) {
        ctx.beginPath();
        ctx.arc(0, 0, p.size * 0.6, 0, Math.PI * 2);
        ctx.fill();
      } else {
        ctx.fillRect(-p.size * 0.35, -p.size * 0.7, p.size * 0.7, p.size * 1.4);
      }

      // white center flash on larger pieces
      if (p.size > 6 && twinkle > 0.75) {
        ctx.fillStyle = `rgba(255,255,255,${(twinkle - 0.75) * 2.5})`;
        ctx.shadowBlur = 0;
        ctx.beginPath();
        ctx.arc(0, 0, p.size * 0.18, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();

      if (p.y > H + 20) particles.splice(i, 1);
    }

    requestAnimationFrame(draw);
  }

  window.addEventListener('resize', () => {
    clearTimeout(window._rt);
    window._rt = setTimeout(resize, 200);
  });

  resize();
  requestAnimationFrame(draw);
})();
</script>
