<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --purple: #7B4FA6;
  --purple-dark: #3d1f5c;
  --purple-mid: #5c3080;
  --purple-light: #c49be0;
  --bg-dark: #1e0e2e;
  --bg-panel: #2d1248;

  --pinkdark: #a8449e;   /* antes #c03692 — agora roxo-magenta */
  --pink: #bf6db8;        /* antes #e267a1 — agora lilás-rosa */

  --teal: #5ecfc4;
  --white: #f0eaf8;
}
html { scroll-behavior: smooth; }
body { font-family: 'Nunito', sans-serif; background: var(--bg-dark); color: var(--white); overflow-x: hidden; }

/* GLITTER */
#glitter-canvas { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 999; }

@keyframes shimmer-text {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
.hero-heading { background: linear-gradient(90deg, #fff 30%, var(--pink) 50%, #c49be0 65%, #fff 80%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: shimmer-text 4s linear infinite; }
.section-title { background: linear-gradient(90deg, #fff 30%, var(--pink) 50%, #c49be0 65%, #fff 80%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: shimmer-text 5s linear infinite; }
.section-title span { background: linear-gradient(90deg, var(--pinkdark) 0%, var(--pink) 50%, var(--pinkdark) 100%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: shimmer-text 3s linear infinite; }

/* NAV */
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 200; display: flex; align-items: center; justify-content: space-between; padding: 1rem 3rem; }
.nav-logo { font-family: 'Caveat', cursive; font-size: 2rem; font-weight: 700; color: var(--white); text-decoration: none; }
.nav-links { display: flex; gap: 2rem; list-style: none; }
.nav-links a { font-weight: 700; font-size: 0.9rem; color: var(--white); text-decoration: none; opacity: 0.8; transition: opacity 0.2s, color 0.2s; }
.nav-links a:hover { opacity: 1; color: var(--pink); }

/* HERO */
.hero { min-height: 100vh; display: grid; grid-template-columns: 1fr 1.1fr; }

/* Illustration */
.hero-left { background: #140920; display: flex; align-items: flex-end; justify-content: center; padding-top: 5rem; position: relative; overflow: hidden; }
.hero-left::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 10%, rgba(123,79,166,0.25) 0%, transparent 65%); }
.illustration { position: relative; width: 320px; height: 370px; }
.lamp-cord { position: absolute; left: 50%; top: 0; width: 3px; height: 85px; background: #555; transform: translateX(-50%); }
.lamp-shade { position: absolute; left: 50%; top: 65px; transform: translateX(-50%); width: 0; height: 0; border-left: 48px solid transparent; border-right: 48px solid transparent; border-top: 65px solid #9b72cc; filter: drop-shadow(0 0 25px rgba(180,140,255,0.45)); }
.lamp-bulb { position: absolute; left: 50%; top: 127px; transform: translateX(-50%); width: 16px; height: 16px; border-radius: 50%; background: #fff8c0; box-shadow: 0 0 18px 9px rgba(255,240,150,0.3), 0 0 55px 28px rgba(255,240,100,0.12); }
.light-cone { position: absolute; left: 50%; top: 142px; transform: translateX(-50%); width: 0; height: 0; border-left: 105px solid transparent; border-right: 105px solid transparent; border-top: 175px solid rgba(255,240,150,0.06); }
.desk { position: absolute; bottom: 38px; left: 0; right: 0; height: 16px; background: #2e1545; border-radius: 4px; }
.desk::before { content: ''; position: absolute; bottom: -48px; left: 8%; width: 28%; height: 48px; background: #2e1545; border-radius: 0 0 4px 4px; }
.desk::after { content: ''; position: absolute; bottom: -48px; right: 8%; width: 28%; height: 48px; background: #2e1545; border-radius: 0 0 4px 4px; }
.monitor-stand { position: absolute; bottom: 54px; left: 50%; transform: translateX(-50%); width: 12px; height: 26px; background: #4a4a5a; border-radius: 2px; }
.monitor-base { position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%); width: 55px; height: 7px; background: #4a4a5a; border-radius: 4px; }
.monitor { position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%); width: 185px; height: 125px; background: #0f0820; border: 3px solid #555; border-radius: 10px; overflow: hidden; }
.monitor-screen { width: 100%; height: 100%; background: #0a0515; padding: 8px; display: flex; flex-direction: column; gap: 5px; }
.cl { height: 6px; border-radius: 3px; background: rgba(255,255,255,0.1); }
.books { position: absolute; bottom: 54px; left: 14px; display: flex; align-items: flex-end; gap: 3px; }
.book { border-radius: 2px 2px 0 0; }
.mug { position: absolute; bottom: 54px; right: 65px; width: 22px; height: 20px; background: var(--pink); border-radius: 3px 3px 5px 5px; }
.mug::after { content: ''; position: absolute; right: -7px; top: 4px; width: 7px; height: 9px; border: 3px solid var(--pink); border-left: none; border-radius: 0 5px 5px 0; }
.plant { position: absolute; bottom: 48px; right: 18px; }
.pot { width: 26px; height: 20px; background: #b05040; border-radius: 2px 2px 5px 5px; position: relative; }
.pot::before { content: ''; position: absolute; top: -5px; left: -3px; width: 32px; height: 7px; background: #c06050; border-radius: 3px; }
.leaf { position: absolute; background: #4a9a60; border-radius: 50% 0 50% 0; }

/* Hero text */
.hero-right { background: var(--purple); display: flex; flex-direction: column; justify-content: center; padding: 6rem 4rem 4rem; }
.hero-greeting { font-family: 'Caveat', cursive; font-size: 1.5rem; color: var(--pink); margin-bottom: 1rem; }
.hero-heading { font-size: clamp(2.4rem, 4vw, 3.8rem); font-weight: 900; line-height: 1.1; color: white; margin-bottom: 2rem; }
.hero-heading .cursive { font-family: 'Caveat', cursive; font-weight: 700; color: rgba(255,255,255,0.65); }
.hero-heading .outline { -webkit-text-stroke: 2px white; color: transparent; font-style: italic; }
.hero-cta { display: inline-block; background: var(--pinkdark); color: white; font-weight: 900; font-size: 0.95rem; letter-spacing: 0.05em; text-decoration: none; padding: 0.85rem 2rem; border-radius: 50px; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 4px 4px 0 rgba(0,0,0,0.25); }
.hero-cta:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 rgba(0,0,0,0.25); }

/* Sections */
section { padding: 6rem 3rem; }
.section-inner { max-width: 1000px; margin: 0 auto; }
.section-label { font-family: 'Caveat', cursive; font-size: 1.3rem; color: var(--purple-light); display: block; margin-bottom: 0.3rem; }
.section-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: white; margin-bottom: 3rem; line-height: 1; }
.section-title span { color: var(--pink); }

/* Sobre */
#sobre { background: var(--bg-panel); }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.about-blob { width: 100%; aspect-ratio: 1; max-width: 300px; border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%; background: linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%); display: flex; align-items: center; justify-content: center; font-size: 5.5rem; animation: morph 8s ease-in-out infinite; box-shadow: 0 0 50px rgba(123,79,166,0.4); }
@keyframes morph { 0%,100% { border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%; } 50% { border-radius: 37% 63% 46% 54% / 48% 55% 45% 52%; } }
.about-text p { font-size: 1.05rem; line-height: 1.8; color: rgba(240,234,248,0.78); margin-bottom: 1rem; }
.about-text p strong { color: var(--pink); font-weight: 700; }

/* Habilidades */
#habilidades { background: var(--bg-dark); }
.skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 1.4rem; }
.skill-card { background: var(--bg-panel); border: 2px solid rgba(123,79,166,0.4); border-radius: 20px; padding: 1.8rem 1.2rem; text-align: center; transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s; }
.skill-card:hover { transform: translateY(-8px) rotate(-1deg); border-color: var(--pinkdark); box-shadow: 0 16px 40px rgba(168,68,158,0.2); }
.skill-icon { font-size: 2.2rem; display: block; margin-bottom: 0.8rem; }
.skill-name { font-weight: 900; font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: white; margin-bottom: 0.8rem; }
.skill-bar { background: rgba(255,255,255,0.1); border-radius: 10px; height: 6px; }
.skill-fill { height: 6px; border-radius: 10px; background: linear-gradient(90deg, var(--purple-light), var(--pinkdark)); }

/* Formação */
#formacao { background: var(--purple-mid); }
.timeline { position: relative; padding-left: 2.5rem; }
.timeline::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--pinkdark); border-radius: 3px; }
.timeline-item { position: relative; margin-bottom: 3rem; }
.timeline-dot { position: absolute; left: -3.1rem; top: 0.2rem; width: 16px; height: 16px; border-radius: 50%; background: var(--pinkdark); border: 3px solid var(--purple-mid); box-shadow: 0 0 0 3px var(--pinkdark); }
.timeline-year { font-family: 'Caveat', cursive; font-size: 1.1rem; color: var(--pink); font-weight: 700; }
.timeline-course { font-size: 1.25rem; font-weight: 900; color: white; margin: 0.2rem 0; }
.timeline-school { font-size: 0.88rem; color: rgba(240,234,248,0.6); }

/* Portfolio */
#portfolio { background: var(--bg-panel); }
.projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem; }
.project-card { background: var(--bg-dark); border: 2px solid rgba(123,79,166,0.4); border-radius: 20px; overflow: hidden; transition: transform 0.25s, box-shadow 0.25s; }
.project-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(123,79,166,0.3); border-color: var(--purple-light); }
.project-thumb { height: 140px; display: flex; align-items: center; justify-content: center; font-size: 3.5rem; background: linear-gradient(135deg, var(--purple-dark), var(--purple-mid)); }
.project-body { padding: 1.4rem; }
.project-tag { display: inline-block; background: rgba(168,68,158,0.15); color: var(--pink); border: 1px solid rgba(168,68,158,0.4); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.8rem; border-radius: 20px; margin-bottom: 0.6rem; }
.project-name { font-size: 1.1rem; font-weight: 900; color: white; margin-bottom: 0.5rem; }
.project-desc { font-size: 0.9rem; color: rgba(240,234,248,0.6); line-height: 1.6; }

/* Em breve */
.coming-soon-box { text-align: center; padding: 4rem 2rem; border: 2px dashed rgba(123,79,166,0.4); border-radius: 24px; background: rgba(123,79,166,0.05); max-width: 520px; margin: 0 auto; }
.coming-soon-icon { font-size: 3.5rem; margin-bottom: 1rem; animation: float 3s ease-in-out infinite; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
.coming-soon-title { font-size: 2rem; font-weight: 900; color: var(--lavender); margin-bottom: 0.75rem; }
.coming-soon-desc { color: rgba(240,234,248,0.65); font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem; }
.coming-soon-dots { display: flex; gap: 0.5rem; justify-content: center; }
.coming-soon-dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--pinkdark); animation: blink 1.4s ease-in-out infinite; }
.coming-soon-dots span:nth-child(2) { animation-delay: 0.2s; }
.coming-soon-dots span:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); } 40% { opacity: 1; transform: scale(1.2); } }

/* Contato */
#contato { background: var(--bg-dark); }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 3rem; align-items: start; }
.contact-info p { color: rgba(240,234,248,0.72); line-height: 1.8; margin-bottom: 1.8rem; }
.contact-links { display: flex; flex-direction: column; gap: 1rem; }
.contact-link { display: flex; align-items: center; gap: 1rem; text-decoration: none; color: white; font-weight: 700; transition: color 0.2s; }
.contact-link:hover { color: var(--pink); }
.contact-link-icon { width: 40px; height: 40px; border-radius: 12px; background: var(--bg-panel); border: 2px solid rgba(123,79,166,0.5); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
.contact-form { display: flex; flex-direction: column; gap: 1rem; }
.form-label { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--purple-light); display: block; margin-bottom: 0.3rem; }
.form-input, .form-textarea { width: 100%; border: 2px solid rgba(123,79,166,0.4); border-radius: 12px; padding: 0.8rem 1rem; font-family: 'Nunito', sans-serif; font-size: 0.95rem; color: white; background: var(--bg-panel); outline: none; transition: border-color 0.2s; resize: none; }
.form-input:focus, .form-textarea:focus { border-color: var(--pinkdark); }
.form-input::placeholder, .form-textarea::placeholder { color: rgba(255,255,255,0.28); }
.form-submit { background: var(--pinkdark); color: white; border: none; border-radius: 50px; padding: 0.9rem 2rem; font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 0.9rem; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 4px 4px 0 rgba(0,0,0,0.25); align-self: flex-start; }
.form-submit:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 rgba(0,0,0,0.25); }

/* Footer */
footer { background: var(--bg-panel); text-align: center; padding: 2.5rem; color: rgba(240,234,248,0.45); font-size: 0.85rem; border-top: 1px solid rgba(123,79,166,0.25); }
footer span { color: var(--pink); }

/* QR Code */
.qr-wrapper { margin-top: 2rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
.qr-box { background: white; border-radius: 16px; padding: 10px; width: 110px; height: 110px; flex-shrink: 0; }
.qr-box svg { width: 90px; height: 90px; }
.qr-label { font-size: 0.82rem; color: rgba(240,234,248,0.6); line-height: 1.6; }
.qr-label strong { color: var(--pink); display: block; margin-bottom: 0.3rem; font-size: 0.9rem; }

/* CV Button */
.cv-download { display: inline-flex; align-items: center; gap: 0.6rem; background: transparent; color: white; font-weight: 900; font-size: 0.9rem; letter-spacing: 0.04em; text-decoration: none; padding: 0.85rem 2rem; border-radius: 50px; border: 2px solid var(--pinkdark); transition: transform 0.2s, box-shadow 0.2s, background 0.2s; box-shadow: 4px 4px 0 rgba(0,0,0,0.25); margin-top: 1.5rem; display: flex; width: fit-content; }
.cv-download:hover { background: var(--pinkdark); transform: translate(-2px,-2px); box-shadow: 6px 6px 0 rgba(0,0,0,0.25); }

@media (max-width: 768px) {
  .hero { grid-template-columns: 1fr; }
  .hero-left { min-height: 320px; }
  .about-grid, .contact-grid { grid-template-columns: 1fr; }
  nav { padding: 1rem 1.5rem; }
  .nav-links { display: none; }
  section { padding: 4rem 1.5rem; }
  .hero-right { padding: 3rem 2rem; }
}
</style>
